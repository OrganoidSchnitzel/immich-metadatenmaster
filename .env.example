# Optional: everything here can also be set on the Settings page in the browser.
# A value set here takes precedence and is shown read-only on that page.
# With Docker Compose, use `env_file: .env` or put the values under `environment:`.

# --- Immich ------------------------------------------------------------------------------
# Immich server as seen from this tool (with or without /api)
# IMMICH_URL=http://192.168.1.10:2283
# Immich > Account settings > API keys. Permissions needed: see README.
# IMMICH_API_KEY=

# URL your browser uses for Immich, for the "Open in Immich" links (default: IMMICH_URL)
# IMMICH_PUBLIC_URL=https://photos.example.com

# Time zone used when writing dates (IANA name)
# TIMEZONE=Europe/Berlin
# "middle": 1987 -> 1987-07-02, 06.1987 -> 1987-06-15.  "start": 1987 -> 1987-01-01
# DATE_ANCHOR=middle
# Tag root for changed photos ("Metadatenmaster/Date/Manual", "Metadatenmaster/Location/GPX", ...); empty disables tags
# TAG_ROOT="Metadatenmaster"
# Add a line explaining the estimate to the photo description
# WRITE_DESCRIPTION=true
# Default of "remove photos from this album once dated" on the album page
# REMOVE_FROM_ALBUM=false

# Age model: "mivolo" (default, local, fast on CPU) or "ollama" (vision language model)
# AGE_ESTIMATOR=mivolo
# DEVICE=cpu
# MIVOLO_MODEL=iitolstykh/mivolo_v2
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5vl:7b

# Faces smaller than this in Immich's preview are cropped from the original scan instead
# MIN_FACE_PX=64
# USE_ORIGINAL_FOR_SMALL_FACES=true

# Background map of the Locations page (any XYZ tile server) and its attribution
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
# Address search on the map (a Photon geocoder; the server sends the search text there). Empty disables it.
# GEOCODER_URL=https://photon.komoot.io

# Where the SQLite store (GPX tracks, records) and calibration live (the Docker image uses /data)
# DATA_DIR=data
